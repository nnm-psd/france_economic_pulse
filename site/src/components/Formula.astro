---
// A formula rendered at build time to native MathML: no client JavaScript, no math fonts, read by screen readers.
import katex from "katex";

interface Props {
  tex: string;
  block?: boolean;
}
const { tex, block = false } = Astro.props;
const html = katex.renderToString(tex, { output: "mathml", displayMode: block, throwOnError: true });
---

{block ? <div class="math-block" set:html={html} /> : <Fragment set:html={html} />}

<style>
  .math-block {
    overflow-x: auto;
    padding-block: 0.25rem;
    font-size: 1.15rem;
  }
</style>
